{
  "id": "anterior-forearm",
  "regionId": "forearm",
  "title": "아래팔 앞칸 해부",
  "region": "오른쪽 아래팔",
  "view": "anterior",
  "summary": "얕은 굽힘근, 노동맥·자동맥과 신경, 깊은 굽힘근 위의 정중신경",
  "source": "일반적인 해부 실습서의 아래팔 앞칸 절차를 단순화한 예시 시나리오 (검수되지 않음)",
  "steps": [
    {
      "id": "skin-incision",
      "type": "incision",
      "title": "피부 세로 절개",
      "instruction": "메스로 아래팔 앞면 정중선을 따라 팔꿈치 쪽에서 손목 쪽까지 피부를 세로로 절개하세요. 가쪽에는 노쪽피부정맥, 안쪽에는 자쪽피부정맥이 지나갑니다.",
      "scene": {
        "layers": {
          "skin": "show",
          "subcut": "show",
          "superficial": "show",
          "fascia": "show",
          "muscle": "show",
          "neurovascular": "show",
          "bone": "show"
        },
        "skinOpen": false,
        "retracted": {}
      },
      "incision": {
        "phiDeg": 0,
        "yFrom": 9,
        "yTo": -9,
        "tolerance": 0.8,
        "minCoverage": 0.8
      },
      "preserve": [
        "cephalic_vein",
        "basilic_vein"
      ]
    },
    {
      "id": "reflect-skin",
      "type": "action",
      "title": "피부판 젖히기",
      "instruction": "피부를 안쪽과 가쪽으로 젖혀 피하조직을 드러내세요.",
      "scene": {
        "layers": {
          "skin": "show",
          "subcut": "show",
          "superficial": "show",
          "fascia": "show",
          "muscle": "show",
          "neurovascular": "show",
          "bone": "show"
        },
        "skinOpen": false,
        "retracted": {}
      },
      "actionLabel": "피부판 젖히기",
      "effect": "openSkin"
    },
    {
      "id": "superficial-veins",
      "type": "identify",
      "title": "표재정맥 찾기",
      "instruction": "피하조직 안에서 아래팔 가쪽과 안쪽을 따라 올라가는 두 정맥을 찾아 클릭하세요.",
      "scene": {
        "layers": {
          "skin": "show",
          "subcut": "ghost",
          "superficial": "show",
          "fascia": "ghost",
          "muscle": "show",
          "neurovascular": "show",
          "bone": "show"
        },
        "skinOpen": true,
        "retracted": {}
